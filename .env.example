# ==============================================================================
# MATCH@SAHRDAYA — Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local Next.js development:
#   cp .env.example .env.local
#
# DO NOT commit .env or .env.local to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Frontend (Next.js) Configuration
# ------------------------------------------------------------------------------
# Base application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# GraphQL API Endpoint exposed by NestJS backend
NEXT_PUBLIC_GRAPHQL_ENDPOINT=http://localhost:4000/graphql

# Environment mode ('development' | 'production' | 'test')
NEXT_PUBLIC_ENV=development

# ------------------------------------------------------------------------------
# 2. Backend (NestJS) Configuration
# ------------------------------------------------------------------------------
BACKEND_PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Database Configuration (PostgreSQL)
# ------------------------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=match_sahrdaya
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/match_sahrdaya?schema=public

# Optional Redis Cache / Session Store URL
REDIS_URL=redis://localhost:6379

# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super-secret-refresh-key-replace-in-production
JWT_REFRESH_EXPIRES_IN=30d

# ------------------------------------------------------------------------------
# 5. External APIs & AI Integration
# ------------------------------------------------------------------------------
# Google Gemini API key for AI-assisted Cupid matchmaking & icebreakers
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 6. Observability & Monitoring
# ------------------------------------------------------------------------------
# Sentry DSN for error reporting
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Prometheus metrics port
PROMETHEUS_METRICS_PORT=9090
